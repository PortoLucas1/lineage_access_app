{
  "datasets": [
    {
      "name": "ds_events",
      "displayName": "Daily lineage events",
      "queryLines": [
        "SELECT date, new_edges, new_edges_from_mv, assets_touched FROM serverless_stable_7caj7s_catalog.dev_melissa_pang_demo_lineage_access_for_every_team_b89e91.gold_lineage_events_daily "
      ]
    },
    {
      "name": "ds_assets",
      "displayName": "Assets",
      "queryLines": [
        "SELECT asset_name, asset_type, criticality, has_pii, domain, downstream_count, blast_radius_usd, principals_with_access, CASE WHEN has_pii THEN 'PII' ELSE 'No PII' END AS pii_label FROM serverless_stable_7caj7s_catalog.dev_melissa_pang_demo_lineage_access_for_every_team_b89e91.gold_assets "
      ]
    },
    {
      "name": "ds_grants",
      "displayName": "Access grants",
      "queryLines": [
        "SELECT asset_name, asset_type, asset_has_pii, asset_criticality, principal, principal_type, department, privilege, member_count, granted_by, granted_date FROM serverless_stable_7caj7s_catalog.dev_melissa_pang_demo_lineage_access_for_every_team_b89e91.gold_access_grants "
      ]
    },
    {
      "name": "ds_edges",
      "displayName": "MV lineage graph (nodes + edges)",
      "queryLines": [
        "WITH node_pos AS ( SELECT * FROM VALUES ",
        "  ('customer_pii', 16.0, 68.0), ('orders_gold', 16.0, 34.0), ('mv_exec_revenue_daily', 50.0, 51.0), ",
        "  ('Executive Revenue', 84.0, 90.0), ('Finance Performance', 84.0, 70.0), ('Revenue Operations', 84.0, 50.0), ",
        "  ('monthly_close_analysis', 84.0, 30.0), ('revenue_governance_agent', 84.0, 10.0) ",
        "  AS t(asset_name, cx, cy) ), ",
        "nodes AS ( SELECT 'node' AS kind, a.asset_name AS label, a.asset_type AS ntype, a.has_pii AS pii, ",
        "  a.principals_with_access AS principals, a.blast_radius_usd AS blast, p.cx AS x, p.cy AS y, ",
        "  CAST(NULL AS DOUBLE) AS x2, CAST(NULL AS DOUBLE) AS y2, ",
        "  p.cx - 14.0 AS bx0, p.cx + 14.0 AS bx1, p.cy - 8.0 AS by0, p.cy + 8.0 AS by1 ",
        "  FROM serverless_stable_7caj7s_catalog.dev_melissa_pang_demo_lineage_access_for_every_team_b89e91.gold_assets a JOIN node_pos p ON a.asset_name = p.asset_name ), ",
        "edges AS ( SELECT 'edge' AS kind, CAST(NULL AS STRING) AS label, CAST(NULL AS STRING) AS ntype, ",
        "  CAST(NULL AS BOOLEAN) AS pii, CAST(NULL AS INT) AS principals, CAST(NULL AS INT) AS blast, ",
        "  sx AS x, sy AS y, tx AS x2, ty AS y2, CAST(NULL AS DOUBLE) AS bx0, CAST(NULL AS DOUBLE) AS bx1, ",
        "  CAST(NULL AS DOUBLE) AS by0, CAST(NULL AS DOUBLE) AS by1 ",
        "  FROM VALUES (30.0,68.0,36.0,53.0),(30.0,34.0,36.0,49.0),(64.0,51.0,70.0,90.0), ",
        "  (64.0,51.0,70.0,70.0),(64.0,51.0,70.0,50.0),(64.0,51.0,70.0,30.0), ",
        "  (64.0,51.0,70.0,10.0) AS e(sx,sy,tx,ty) ) ",
        "SELECT * FROM nodes UNION ALL SELECT * FROM edges "
      ]
    },
    {
      "name": "ds_mv",
      "displayName": "MV headline (single row)",
      "queryLines": [
        "SELECT downstream_count, blast_radius_usd FROM serverless_stable_7caj7s_catalog.dev_melissa_pang_demo_lineage_access_for_every_team_b89e91.gold_assets WHERE asset_name = 'mv_exec_revenue_daily' "
      ]
    },
    {
      "name": "ds_pii_exposed",
      "displayName": "PII exposure (single row)",
      "queryLines": [
        "SELECT MAX(principals_with_access) AS pii_exposed FROM serverless_stable_7caj7s_catalog.dev_melissa_pang_demo_lineage_access_for_every_team_b89e91.gold_assets WHERE has_pii "
      ]
    },
    {
      "name": "ds_user_grants",
      "displayName": "Access grants at user grain",
      "queryLines": [
        "SELECT g.asset_name, g.asset_type, g.asset_has_pii, g.asset_criticality, ",
        "g.principal AS granted_principal, g.principal_type, ",
        "COALESCE(m.member_email, g.principal) AS user_principal, ",
        "COALESCE(m.member_display_name, g.display_name, g.principal) AS user_name, ",
        "COALESCE(m.member_department, g.department) AS user_department, ",
        "CASE WHEN g.principal_type = 'group' THEN g.principal END AS via_group, ",
        "g.privilege, g.granted_by, g.granted_date ",
        "FROM serverless_stable_7caj7s_catalog.dev_melissa_pang_demo_lineage_access_for_every_team_b89e91.gold_access_grants g ",
        "LEFT JOIN serverless_stable_7caj7s_catalog.dev_melissa_pang_demo_lineage_access_for_every_team_b89e91.gold_group_members m ",
        "ON g.principal_type = 'group' AND g.principal = m.group_name "
      ]
    },
    {
      "name": "ds_group_members",
      "displayName": "User groups and members",
      "queryLines": [
        "SELECT group_name, group_display_name, group_department, member_count, ",
        "member_email, member_display_name, member_department FROM serverless_stable_7caj7s_catalog.dev_melissa_pang_demo_lineage_access_for_every_team_b89e91.gold_group_members "
      ]
    },
    {
      "name": "ds_service_principals",
      "displayName": "Service principals",
      "queryLines": [
        "SELECT principal, display_name, department, application_id, owner_email FROM serverless_stable_7caj7s_catalog.dev_melissa_pang_demo_lineage_access_for_every_team_b89e91.gold_service_principals "
      ]
    }
  ],
