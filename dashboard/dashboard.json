{
  "datasets": [
    {
      "name": "ds_events",
      "displayName": "Daily lineage events",
      "queryLines": [
        "SELECT date, new_edges, new_edges_from_mv, assets_touched FROM gold_lineage_events_daily "
      ]
    },
    {
      "name": "ds_assets",
      "displayName": "Assets",
      "queryLines": [
        "SELECT asset_name, asset_type, criticality, has_pii, domain, downstream_count, blast_radius_usd, principals_with_access, has_over_broad_grant, CASE WHEN has_pii THEN 'PII' ELSE 'No PII' END AS pii_label FROM gold_assets "
      ]
    },
    {
      "name": "ds_grants",
      "displayName": "Access grants",
      "queryLines": [
        "SELECT asset_name, asset_type, asset_has_pii, asset_criticality, principal, principal_type, department, privilege, member_count, is_over_broad, CASE WHEN is_over_broad THEN 'Over-broad' ELSE 'Scoped' END AS grant_scope, granted_by, granted_date FROM gold_access_grants "
      ]
    },
    {
      "name": "ds_edges",
      "displayName": "MV lineage graph (nodes + edges)",
      "queryLines": [
        "WITH node_pos AS ( SELECT * FROM VALUES ",
        "  ('customer_pii', 16.0, 68.0), ('orders_gold', 16.0, 34.0), ('mv_exec_revenue_daily', 50.0, 51.0), ",
        "  ('Executive Revenue', 84.0, 86.0), ('Executive Revenue AI/BI', 84.0, 63.0), ('finance_monthly_close', 84.0, 40.0) ",
        "  AS t(asset_name, cx, cy) ), ",
        "nodes AS ( SELECT 'node' AS kind, a.asset_name AS label, a.asset_type AS ntype, a.has_pii AS pii, ",
        "  a.principals_with_access AS principals, a.blast_radius_usd AS blast, p.cx AS x, p.cy AS y, ",
        "  CAST(NULL AS DOUBLE) AS x2, CAST(NULL AS DOUBLE) AS y2, ",
        "  p.cx - 14.0 AS bx0, p.cx + 14.0 AS bx1, p.cy - 8.0 AS by0, p.cy + 8.0 AS by1 ",
        "  FROM gold_assets a JOIN node_pos p ON a.asset_name = p.asset_name ",
        "  UNION ALL SELECT 'node', 'Other downstream (15 assets)', 'group', false, 0, 0, 84.0, 17.0, ",
        "  CAST(NULL AS DOUBLE), CAST(NULL AS DOUBLE), 70.0, 98.0, 9.0, 25.0 ), ",
        "edges AS ( SELECT 'edge' AS kind, CAST(NULL AS STRING) AS label, CAST(NULL AS STRING) AS ntype, ",
        "  CAST(NULL AS BOOLEAN) AS pii, CAST(NULL AS INT) AS principals, CAST(NULL AS INT) AS blast, ",
        "  sx AS x, sy AS y, tx AS x2, ty AS y2, CAST(NULL AS DOUBLE) AS bx0, CAST(NULL AS DOUBLE) AS bx1, ",
        "  CAST(NULL AS DOUBLE) AS by0, CAST(NULL AS DOUBLE) AS by1 ",
        "  FROM VALUES (30.0,68.0,36.0,53.0),(30.0,34.0,36.0,49.0),(64.0,51.0,70.0,86.0), ",
        "  (64.0,51.0,70.0,63.0),(64.0,51.0,70.0,40.0),(64.0,51.0,70.0,17.0) AS e(sx,sy,tx,ty) ) ",
        "SELECT * FROM nodes UNION ALL SELECT * FROM edges "
      ]
    },
    {
      "name": "ds_mv",
      "displayName": "MV headline (single row)",
      "queryLines": [
        "SELECT downstream_count, blast_radius_usd FROM gold_assets WHERE asset_name = 'mv_exec_revenue_daily' "
      ]
    },
    {
      "name": "ds_overbroad_pii",
      "displayName": "Over-broad PII exposure (single row)",
      "queryLines": [
        "SELECT MAX(member_count) AS pii_exposed FROM gold_access_grants WHERE is_over_broad AND asset_has_pii "
      ]
    }
  ],
